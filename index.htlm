<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>NexaPay</title>

  <!-- Pi SDK -->
  <script src="https://sdk.minepi.com/pi-sdk.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f2fa;
      color: #222;
    }

    .header {
      background: #6f3fa0;
      color: white;
      text-align: center;
      padding: 30px 20px;
    }

    .logo {
      font-size: 42px;
    }

    .header h1 {
      margin: 8px 0;
      font-size: 32px;
    }

    .header p {
      margin: 0;
      font-size: 16px;
    }

    .container {
      max-width: 520px;
      margin: 25px auto;
      padding: 15px;
    }

    .card {
      background: white;
      padding: 25px;
      margin-bottom: 18px;
      border-radius: 18px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .service {
      padding: 15px;
      margin: 10px 0;
      border-radius: 12px;
      background: #f1eafa;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 12px;
      padding: 15px;
      margin-top: 10px;
      background: #6f3fa0;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:disabled {
      background: #aaa;
    }

    #userBox {
      display: none;
    }

    #message {
      margin-top: 15px;
      padding: 12px;
      border-radius: 10px;
      background: #f1eafa;
      display: none;
    }
  </style>
</head>

<body>

  <div class="header">
    <div class="logo">🟣</div>
    <h1>NexaPay</h1>
    <p>Fast & Secure Pi Payments</p>
  </div>

  <div class="container">

    <div class="card">

      <h2>Welcome to NexaPay</h2>

      <p>A simple payment platform built for the Pi ecosystem.</p>

      <button id="loginBtn">
        Sign in with Pi
      </button>

      <div id="message"></div>

      <button id="payBtn" style="display:none;">
        🟣 Test Payment — 0.1 Pi
      </button>

    </div>

    <div class="card" id="userBox">

      <h2>Welcome 👋</h2>

      <p>
        Pi Username:
        <strong id="username">---</strong>
      </p>

      <button id="logoutBtn">
        Sign Out
      </button>

    </div>

    <div class="card">

      <h2>Services</h2>

      <div class="service">
        📱 <strong>Airtime</strong><br>
        <small>Buy airtime with Pi</small>
      </div>

      <div class="service">
        🌐 <strong>Data</strong><br>
        <small>Buy data with Pi</small>
      </div>

      <div class="service">
        🟣 <strong>Pi Payments</strong><br>
        <small>Secure Pi transactions</small>
      </div>

      <div class="service">
        🧾 <strong>Transaction History</strong><br>
        <small>View your payments</small>
      </div>

    </div>

  </div>

  <script>

    let accessToken = null;
    let currentUser = null;

    const Pi = window.Pi;

    Pi.init({
      version: "2.0",
      sandbox: true
    });


    async function loginWithPi() {

      const button = document.getElementById("loginBtn");

      if (!window.Pi) {
        showMessage("Pi SDK bai load ba.");
        return;
      }

      button.disabled = true;
      button.innerText = "Connecting to Pi...";

      try {

        const auth = await Pi.authenticate(
          ["username", "payments"],
          onIncompletePaymentFound
        );

        accessToken = auth.accessToken;
        currentUser = auth.user;

        document.getElementById("username").innerText =
          currentUser.username;

        document.getElementById("userBox").style.display =
          "block";

        button.style.display = "none";

        document.getElementById("payBtn").style.display =
          "block";

        showMessage(
          "Welcome to NexaPay, " +
          currentUser.username + "!"
        );

      } catch (error) {

        console.error(error);

        showMessage("Pi Login failed.");

        button.disabled = false;
        button.innerText = "Sign in with Pi";
      }
    }


    async function startPayment() {

      if (!currentUser) {
        showMessage("Please sign in first.");
        return;
      }

      const paymentData = {

        amount: 0.1,

        memo: "NexaPay Test Transaction",

        metadata: {
          type: "test_payment"
        }
      };


      const callbacks = {

        onReadyForServerApproval: async function(paymentId) {

          showMessage("Payment created. Approving payment...");

          try {

            const response = await fetch(
              "/api/approve",
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({
                  paymentId: paymentId
                })
              }
            );

            const data = await response.json();

            if (!response.ok) {
              throw new Error(
                data.error || "Approval failed"
              );
            }

            showMessage("Payment approved. Continue in Pi Wallet.");

          } catch (error) {

            console.error(error);

            showMessage(
              "Approval failed: " + error.message
            );
          }
        },


        onReadyForServerCompletion: async function(paymentId, txid) {

          showMessage("Completing payment...");

          try {

            const response = await fetch(
              "/api/complete",
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({
                  paymentId: paymentId,
                  txid: txid
                })
              }
            );

            const data = await response.json();

            if (!response.ok) {
              throw new Error(
                data.error || "Completion failed"
              );
            }

            showMessage(
              "🎉 Test Transaction completed successfully!"
            );

          } catch (error) {

            console.error(error);

            showMessage(
              "Completion failed: " + error.message
            );
          }
        },


        onCancel: function(paymentId) {

          console.log("Payment cancelled:", paymentId);

          showMessage("Payment cancelled.");
        },


        onError: function(error) {

          console.error(error);

          showMessage(
            "Payment error: " +
            (error.message || "Unknown error")
          );
        }
      };


      Pi.createPayment(
        paymentData,
        callbacks
      );
    }


    function onIncompletePaymentFound(payment) {

      console.log(
        "Incomplete payment:",
        payment
      );
    }


    function showMessage(text) {

      const box =
        document.getElementById("message");

      box.innerText = text;
      box.style.display = "block";
    }


    function logoutUser() {

      accessToken = null;
      currentUser = null;

      document.getElementById("userBox").style.display =
        "none";

      document.getElementById("payBtn").style.display =
        "none";

      const button =
        document.getElementById("loginBtn");

      button.style.display = "block";
      button.disabled = false;
      button.innerText = "Sign in with Pi";

      showMessage("You have signed out.");
    }


    document.getElementById("loginBtn").addEventListener(
      "click",
      loginWithPi
    );

    document.getElementById("payBtn").addEventListener(
      "click",
      startPayment
    );

    document.getElementById("logoutBtn").addEventListener(
      "click",
      logoutUser
    );

  </script>

</body>
</html> 